# =====================================================================
# Essay Integrity Checker (CITRA) - environment variables
# Copy to `.env` and fill in real values. DO NOT commit `.env` to git.
# =====================================================================

# --- App & Security ---
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
JWT_SECRET=change-me-in-production-use-env-var
DEMO_USERS_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database & SQLite Tuning ---
DATABASE_URL=sqlite:///./data/app.db
SQLITE_JOURNAL_MODE=WAL

# --- Document Parsing & Worker Topology ---
GROBID_URL=http://localhost:8070
# CITRA_WORKER_MODE: inline (default single-process) | web_only | worker_only
CITRA_WORKER_MODE=inline
CITRA_WORKER_POLL_INTERVAL=2.0
MAX_CONCURRENT_PIPELINES=3
MAX_CONCURRENT_GROBID=2
MAX_GLOBAL_RETRIEVALS=12

# --- Polite pool email (sent via User-Agent to Crossref/OpenAlex/DBLP) ---
CONTACT_EMAIL=noreply@citra.edu.vn

# --- Scholarly, Technical & Google Scholar Fallback API keys ---
OPENALEX_API_KEY=
CROSSREF_API_KEY=
NCBI_API_KEY=
GITHUB_TOKEN=
# Tier-3 Google Scholar Fallback Router: Serper.dev primary (2,500 free at https://serper.dev) -> SerpApi secondary
SERPER_API_KEY=
SERPAPI_API_KEY=

# --- Matching & Symbolic Threshold Overrides (optional, defaults in config.yaml) ---
# MATCHING_ENABLE_MULTILINGUAL_ENCODER=true
# MATCHING_ONNX_QUANTIZED=true
# ABSTENTION_LOW=0.4
# ABSTENTION_HIGH=0.6
# TITLE_SIM_VERIFIED=0.9
# TITLE_SIM_METADATA_ERROR=0.6
# AUTHOR_JACCARD_VERIFIED=0.5
# YEAR_TOLERANCE=1

# --- Paths ---
DATA_DIR=./data
ESSAYS_DIR=./data/essays
CACHE_DIR=./data/cache
GROBID_OUTPUT_DIR=./data/cache/grobid
AVATARS_DIR=./data/avatars
CONFIG_FILE=./configs/config.yaml

# --- Email / SMTP (Account Activation & Password Reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME="CITRA - Academic Source Verification"
FRONTEND_URL=http://localhost:5173

# --- Google OAuth2 (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Stripe Checkout (Pro / Ultra Subscriptions) ---
STRIPE_SECRET_KEY=

# --- VNPay Payment Gateway v2.1.0 (https://sandbox.vnpayment.vn/apis/) ---
VNPAY_TMN_CODE=CITRAVNP
VNPAY_HASH_SECRET=change-me-in-production-vnpay-hmac-sha512-secret
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_RETURN_URL=http://localhost:5173/billing/vnpay-return
VNPAY_USD_TO_VND_RATE=25000
VNPAY_EXTERNAL_REDIRECT=false
