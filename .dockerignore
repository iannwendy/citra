# =====================================================================
# .dockerignore — tránh copy unnecessary files vào Docker image
# =====================================================================

# Git & CI/Tooling metadata
.git
.gitignore
.gitmodules
.github/
.githooks/
.agents/
.superpowers/
.playwright-mcp/

# Python (recursive across nested src/ & scripts/ packages)
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/*.so
.Python
**/*.egg
**/*.egg-info/
dist/
build/
.eggs/

# Virtual env
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Testing & Static Analysis Caches
tests/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.nox/

# Documentation, Knowledge Graph & Thesis LaTeX Sources
*.md
!/requirements*.txt
!/README.md
docs/
graphify-out/
FinalReport_TDTU/
FinalReport_TDTU_VN/

# Frontend & Marketing (build riêng)
node_modules/
web/
marketing/

# Local data & corpora (exclude data/* EXCEPT trained 120K/Platt Neuro-Symbolic weights)
!/data/
data/*
!/data/models/
data/models/*
!/data/models/neuro_symbolic_weights.json
reports/
test-results/
evaluation/
20-theses/
200-theses/
TDTU_PDF/
VN_UNI_PDF_BATCH2/
style_corpora/
tdtu_github_reports/
vn_legal_reports/
6_ICCIES_2027/
TDTU-MidtermReport/
*.pdf
*.docx

# Logs
**/*.log
**/*.log.*

# OS
**/.DS_Store
**/Thumbs.db

# Confidential
.env
.env.*
!/.env.example
.mcp.json
*.pem
*.key

# Docker
Dockerfile*
docker-compose*.yml
.docker/

# Temporary
*.tmp
*.temp
*.bak
